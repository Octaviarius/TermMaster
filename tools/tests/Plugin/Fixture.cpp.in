#include <QFile>
#include <QObject>
#include <QThread>
#include <QTimer>
#include <Termaster/Core/Plugin/HostedPlugin.h>
#include <Termaster/Core/Plugin/Plugin.h>
#include <Termaster/Core/Plugin/PluginHost.h>

#ifdef FIXTURE_PROVIDER
extern "C" int termasterFixtureValue()
{
    return 42;
}
#endif
#ifdef FIXTURE_CONSUMER
extern "C" int termasterFixtureValue();
#endif

#ifdef FIXTURE_PROCESSOR
class AsyncProcessor final : public Processor
{
public:
    AsyncProcessor(QVariantMap configuration, Limits limits) : _configuration(std::move(configuration)), _limits(limits)
    {
    }

    QVariantMap configuration() const override
    {
        return _configuration;
    }

    AcceptResult accept(Chunk input, Callbacks callbacks) override
    {
        if (_stopped || input.bytes.size() > _limits.maxBytes)
        {
            return AcceptResult::Rejected;
        }
        if (_busy)
        {
            return AcceptResult::WouldBlock;
        }
        _busy                 = true;
        const auto generation = _generation;
        QTimer::singleShot(0,
                           this,
                           [this, generation, input = std::move(input), callbacks = std::move(callbacks)]() mutable {
                               if (generation != _generation)
                               {
                                   return;
                               }
                               input.bytes.prepend(_configuration.value("prefix").toString().toUtf8());
                               callbacks.output(std::move(input));
                               if (generation != _generation)
                               {
                                   return;
                               }

                               _busy = false;
                               callbacks.completed({});
                           });
        return AcceptResult::Accepted;
    }

    void cancel(std::function<void()> quiescent) override
    {
        _stopped = true;
        ++_generation;
        QTimer::singleShot(0, this, [this, quiescent = std::move(quiescent)] {
            _busy = false;
            quiescent();
        });
    }

private:
    QVariantMap _configuration;
    Limits      _limits;
    bool        _busy       = false;
    bool        _stopped    = false;
    int         _generation = 0;
};
#endif

class Fixture final : public QObject, public Plugin, public HostedPlugin
{
    Q_OBJECT
    Q_PLUGIN_METADATA(IID "org.octaviarius.Termaster.Plugin/1.0" FILE "@fixture_json@")
    Q_INTERFACES(Plugin HostedPlugin)

private:
    PluginHost* _host   = nullptr;
    State       _state  = State::Stopped;
    QThread*    _worker = nullptr;
    QTimer*     _timer  = nullptr;
    void        _trace(const QByteArray& action) const
    {
        if (!qEnvironmentVariableIsSet("TERMASTER_PLUGIN_TRACE"))
        {
            return;
        }
        QFile file(QString::fromLocal8Bit(qgetenv("TERMASTER_PLUGIN_TRACE")));
        if (file.open(QIODevice::WriteOnly | QIODevice::Append))
        {
            file.write(QByteArray("@fixture_id@:") + action + '\n');
        }
    }

public:
    void setHost(PluginHost* host) override
    {
        _host = host;
    }

    ~Fixture() override
    {
        if (_worker || _timer)
        {
            qFatal("Fixture resources survived shutdown");
        }
        _trace("destroy");
    }
    bool startup(QString* error) override
    {
        _trace("start");
        _worker = new QThread(this);
        _worker->start();
        _timer = new QTimer(this);
        _timer->start(60000);
#ifdef FIXTURE_CONSUMER
        if (termasterFixtureValue() != 42)
        {
            return false;
        }
#endif
#ifdef FIXTURE_START_FAILURE
        _state = State::Failed;
        if (error)
        {
            *error = QStringLiteral("Synthetic startup failure");
        }
        return false;
#endif
#ifdef FIXTURE_PROCESSOR
        ProcessorCatalog::Type type;
        type.id             = QStringLiteral("fixture.async");
        type.title          = QStringLiteral("Fixture asynchronous processor");
        type.settingsSchema = QByteArrayLiteral(
            "version: 1\ntype: termaster.settings-schema\ndescription: Fixture processor\ncontent:\n  type: object\n  properties:\n    label:\n      type: string\n");
        type.create = [](const QVariantMap& configuration, const Processor::Limits& limits, QString*) {
            return std::make_unique<AsyncProcessor>(configuration, limits);
        };
        if (!_host)
        {
            throw std::logic_error("Processor fixture requires its plugin host");
        }

        _host->registerProcessorType(std::move(type));
        ProcessorCatalog::Provider provider;
        provider.validate = [](const QVariantMap& source, QString* error) {
            if (source.value("prefix").typeId() == QMetaType::QString)
            {
                return true;
            }
            if (error)
            {
                *error = QStringLiteral("Fixture code source requires a prefix string");
            }
            return false;
        };
        provider.prepare = [](const QVariantMap& source,
                              const QVariantMap&,
                              const ProcessorCatalog::Provider::References&,
                              const Processor::Limits&,
                              QString*) {
            const auto prefix = source.value("prefix").toString();
            return ProcessorCatalog::Type::Factory(
                [prefix](const QVariantMap& configuration, const Processor::Limits& limits, QString*) {
                    auto effective = configuration;
                    if (!effective.contains("prefix"))
                    {
                        effective.insert("prefix", prefix);
                    }
                    return std::make_unique<AsyncProcessor>(std::move(effective), limits);
                });
        };
        _host->registerProcessorProvider(QStringLiteral("fixture.code"), std::move(provider));
#endif
        _state = State::Running;
        return true;
    }
    bool shutdown(QString* error) override
    {
        _trace("stop");
#ifdef FIXTURE_STOP_FAILURE
        if (qEnvironmentVariableIsSet("TERMASTER_PLUGIN_REFUSE_STOP"))
        {
            _state = State::Failed;
            if (error)
            {
                *error = "Synthetic worker drain failure";
            }
            return false;
        }
#endif
        delete _timer;
        _timer = nullptr;
        if (_worker)
        {
            _worker->quit();
            if (!_worker->wait(2000))
            {
                if (error)
                {
                    *error = "Fixture worker did not stop";
                }
                return false;
            }
            delete _worker;
            _worker = nullptr;
        }
        _state = State::Stopped;
        return true;
    }
    Info info() const override
    {
        // clang-format off
        return {"@fixture_id@", "@fixture_id@", "@fixture_version@", {@fixture_deps_cpp@}};
        // clang-format on
    }
    State state() const override
    {
#ifdef FIXTURE_PROVIDER
        if (qEnvironmentVariableIsSet("TERMASTER_PLUGIN_RUNTIME_FAILURE"))
        {
            return State::Failed;
        }
#endif
        return _state;
    }
};
#include "@fixture_target@.moc"
