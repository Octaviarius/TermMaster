@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Qt6 REQUIRED COMPONENTS Core)

get_filename_component(_termaster_api_root "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
if(NOT TARGET Termaster::PluginApi)
    add_library(Termaster::PluginApi INTERFACE IMPORTED)
    set_target_properties(Termaster::PluginApi PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${_termaster_api_root}/include"
        INTERFACE_LINK_LIBRARIES Qt6::Core
        INTERFACE_COMPILE_FEATURES cxx_std_20
    )
endif()
include("${CMAKE_CURRENT_LIST_DIR}/TermasterPlugin.cmake")

check_required_components(TermasterPluginApi)

unset(_termaster_api_root)
